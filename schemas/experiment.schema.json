{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment",
  "type": "object",
  "required": [
    "id",
    "hypothesis_ids",
    "candidate_ids",
    "baseline_ids",
    "primary_metric",
    "seeds",
    "budget",
    "stages",
    "stop_conditions",
    "status",
    "schema_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[A-Fa-f0-9]{8,}$"
    },
    "schema_version": {
      "type": "string"
    },
    "hypothesis_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "primary_metric": {
      "type": "string"
    },
    "secondary_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seeds": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "integer"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_compute_credits",
        "max_cost"
      ],
      "properties": {
        "max_compute_credits": {
          "type": "number",
          "minimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "approved",
        "running",
        "analyzing",
        "completed",
        "failed",
        "cancelled",
        "archived"
      ]
    }
  },
  "additionalProperties": false
}
